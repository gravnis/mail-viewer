{
  "manifest_version": 3,
  "name": "Mail Viewer — просмотр почты",
  "version": "1.0.0",
  "description": "Просмотр входящих писем по IMAP через корпоративный сервер. Только чтение, без отправки.",
  "permissions": ["storage"],
  "host_permissions": [],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Mail Viewer",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
