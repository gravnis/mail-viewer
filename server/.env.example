# --- Mail Viewer server ---

HOST=127.0.0.1
PORT=8787

# Пароль входа в админку. ОБЯЗАТЕЛЬНО. Рекомендуется 16+ символов.
ADMIN_PASSWORD=

# Ключ шифрования сохранённых паролей/прокси (64 hex-символа). Если пусто — создастся
# в data/secret.key. Сгенерировать свой: openssl rand -hex 32
SECRET_KEY=

SESSION_TTL_HOURS=12

# Исходящие к почте — только через прокси (добавляются в админке). Ротация на коннекте.
PROXY_DEFAULT_SCHEME=socks5
REQUIRE_PROXY=true

# Доверять заголовкам client-IP (CF-Connecting-IP / X-Forwarded-For) ТОЛЬКО если сервер
# реально стоит за Cloudflare/nginx, которые их проставляют. Иначе false (иначе IP можно подделать).
TRUST_PROXY_HEADERS=false

# Лимиты.
RATE_LIMIT_PER_MINUTE=240
LOGIN_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
MAX_CONCURRENT_IMAP=20

IMAP_CONNECT_TIMEOUT_MS=20000
MAX_MESSAGE_BYTES=8388608
MAX_LIST_LIMIT=100

# Где база и ключ шифрования.
DATA_DIR=data

# Включить, только если админка открывается по http:// (dev) — тогда cookie без Secure.
COOKIE_INSECURE=false
# Только для локальных тестов: разрешает приватные хосты и self-signed TLS.
DEV_INSECURE=false
